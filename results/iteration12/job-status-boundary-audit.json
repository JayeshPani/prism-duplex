    "avoid": [
      "Do not mutate executor status or privately send premature SUCCESS while callbacks remain pending.",
      "Do not relabel historical failures or delete a room/dispatch solely to manufacture success.",
      "Changing drain_timeout does not change the disconnect\u2192callback\u2192thread-completion order."
