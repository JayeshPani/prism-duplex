# LiveKit Cloud (free tier): https://cloud.livekit.io -> Settings -> API Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional: only for the official GPT-4o judge (JUDGE=openai)
OPENAI_API_KEY=
# Optional: Moonshot/Kimi as an alternative judge or hosted LLM profile
MOONSHOT_API_KEY=
